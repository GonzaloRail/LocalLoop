# -----------------------------------------------------------------------------
# LocalLoop · Variables de Entorno
# Copia este archivo a .env para desarrollo local
# -----------------------------------------------------------------------------

# Red Stellar (Testnet)
VITE_STELLAR_NETWORK=testnet
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_FRIENDBOT_URL=https://friendbot.stellar.org

# Base de Datos Compartida (Supabase PostgreSQL)
# Opcional para desarrollo local con mock/localStorage.
# REQUERIDO para persistencia multiusuario en Vercel.
# Obtén estas claves en https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui
